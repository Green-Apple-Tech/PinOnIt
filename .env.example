# Copy to .env for local dev. Bolt production reads .env from the repo on publish.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_APP_URL=https://pinonit.com

# Guest-path smoke (src/lib/guestPaths.smoke.test.ts). Service role stays off VITE_ so it is not bundled.
# npm test skips the smoke when this is unset. CI / `npm run test:guest-smoke` require all three.
# SUPABASE_SERVICE_ROLE_KEY=
