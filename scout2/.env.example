SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_PLACES_KEY=AIza...
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=choose-a-long-random-string
# GMass campaign export (share the Drive folder with the service account email)
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-sa.json
DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_CAMPAIGN_SHEET_ID=your-campaign-spreadsheet-id
# Fallback if GOOGLE_SERVICE_ACCOUNT_JSON is unset:
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-sa.json
# Search backend for directory scrapers: free (DuckDuckGo/Bing) or scaleserp
SCOUT2_SEARCH=free
# Optional paid Google SERP. Not used unless SCOUT2_SEARCH=scaleserp.
# SCALESERP_KEY=

# Continuous Places (scripts/run-nightly.sh): one city at a time.
# Daily cap on Google Places searches (29 searches ≈ 1 city). 0 = unlimited.
# SCOUT2_DAILY_QUERY_CAP=80
# SCOUT2_CITIES_PER_CYCLE=1
# SCOUT2_CYCLE_SLEEP_SEC=600

# Optional: paste a BuiltWith / PublicWWW domain list, then fingerprint.
# python -m scout2.cli import-domains ~/Downloads/calendly-sites.csv --source builtwith
SCOUT2_USER_AGENT=PinOnItScout2/1.0 (+https://pinonit.com; research@pinonit.com)
SCOUT2_REQUEST_TIMEOUT_SEC=10
SCOUT2_RETRIES=2
SCOUT2_RATE_PER_DOMAIN=1.0